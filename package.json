{
  "name": "signal-baileys",
  "version": "0.1.0",
  "description": "Baileys-style Signal connector for Node.js — clean TypeScript API, device linking, events, and multi-device support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "example:link": "tsx examples/link-device.ts",
    "example:bot": "tsx examples/simple-bot.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "signal",
    "baileys",
    "messaging",
    "bot",
    "e2ee",
    "signal-protocol",
    "whatsapp-alternative"
  ],
  "author": "NYXCORE-X",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@milady/signal-native": "^0.1.0",
    "pino": "^9.5.0",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
